{
  "abbreviation": "ADR",
  "name": "Architecture Decision Record",
  "subdirectory": "adr",
  "frontmatter_schema": {
    "type": "object",
    "required": [
      "title",
      "status"
    ],
    "properties": {
      "title": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "accepted",
          "rejected",
          "superseded"
        ]
      },
      "deciders": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "date": {
        "type": "string"
      }
    }
  },
  "required_sections": [
    "Context",
    "Decision",
    "Consequences"
  ],
  "section_templates": {
    "Context": "Describe the problem or situation requiring a decision.\n",
    "Decision": "Describe the decision that was made and why.\n",
    "Consequences": "Describe the resulting context, trade-offs, and any follow-up actions.\n"
  },
  "suggested_entity_type_connections": [
    "@all"
  ]
}
